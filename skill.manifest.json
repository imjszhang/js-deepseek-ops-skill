      }
    },
    {
      "name": "deepseek_navigate_session",
      "title": "DeepSeek Ops: Navigate To Session",
      "description": "把浏览器导航到 /a/chat/s/<id> （仅 location.assign）",
      "risk": "interactive",
      "capabilities": [
        "browser.tabs.read",
        "browser.navigation",
        "browser.script.execute",
        "filesystem.skillData"
      ],
      "inputSchema": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "required": [],
        "additionalProperties": false,
        "anyOf": [
          {
            "required": [
              "sessionId"
            ]
          },
          {
            "required": [
              "url"
            ]
          }
        ]
      }
    },
    {
      "name": "deepseek_navigate_new_chat",
      "title": "DeepSeek Ops: Navigate To New Chat",
