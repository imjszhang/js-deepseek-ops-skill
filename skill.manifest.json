    {
      "name": "deepseek_feedback_message",
      "title": "DeepSeek Ops: Feedback Message",
      "description": "[DESTRUCTIVE,reversible] 给单条消息打反馈：feedback ∈ {-1=踩, 0=取消, 1=赞}",
      "risk": "destructive",
      "capabilities": [
        "browser.tabs.read",
        "browser.navigation",
        "browser.script.execute",
        "filesystem.skillData"
      ],
      "inputSchema": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "messageId": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "feedback": {
            "type": "integer",
            "enum": [
              -1,
              0,
              1
            ],
            "minimum": -1,
            "maximum": 9007199254740991
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 100
          },
          "comment": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "required": [
          "sessionId",
          "messageId",
          "feedback"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "deepseek_stop_stream",
      "title": "DeepSeek Ops: Stop Stream",
      "description": "[DESTRUCTIVE,reversible] 停止当前会话的流式生成",
      "risk": "destructive",
      "capabilities": [
        "browser.tabs.read",
        "browser.navigation",
        "browser.script.execute",
        "filesystem.skillData"
      ],
      "inputSchema": {
