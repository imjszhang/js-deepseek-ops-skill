      }
    },
    {
      "name": "deepseek_navigate_home",
      "title": "DeepSeek Ops: Navigate To Home",
      "description": "把浏览器导航到 / （仅 location.assign）",
      "risk": "interactive",
      "capabilities": [
        "browser.tabs.read",
        "browser.navigation",
        "browser.script.execute",
        "filesystem.skillData"
      ],
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
