{
  "manifestVersion": 2,
  "id": "js-deepseek-ops-skill",
  "name": "JS DeepSeek Ops Skill",
  "version": "0.5.0",
  "publisher": "imjszhang",
  "description": "DeepSeek Chat 自动化技能：33 个工具、Skill Runtime V2 清单、最小能力声明、默认脱敏审计与不可逆操作备份",
  "entry": "./skill.entry.js",
  "compatibility": {
    "jsEyes": ">=2.8.5 <3",
    "contractApi": "^2.0.0",
    "runtimeApi": "^2.0.0",
    "node": ">=22"
  },
  "requirements": {
    "server": true,
    "browserExtension": true,
    "login": true,
    "platforms": [
      "chat.deepseek.com"
    ]
  },
  "capabilities": {
    "browser": [
      "tabs.read",
      "navigation",
      "script.execute"
    ],
    "network": {
      "direct": false,
      "hosts": []
    },
    "filesystem": [
      "skillData"
    ],
    "process": [],
    "secrets": [],
    "background": false
  },
  "cli": {
    "entry": "./cli/index.js",
    "commands": [
      {
        "name": "doctor",
        "description": "连通性 + 登录态 + bridge 注入 + probe + state 汇总"
      },
      {
        "name": "probe",
        "description": "采集页面指纹（按 page profile）"
      },
      {
        "name": "state",
        "description": "读取当前 page profile 状态"
      },
      {
        "name": "session-state",
        "description": "读取登录态"
      },
      {
        "name": "list-sessions",
        "description": "列出历史会话（标题 / 时间 / 模型类型，不含正文）"
      },
      {
        "name": "get-session",
        "description": "读取单个会话消息历史（默认 redact=off）"
      },
      {
        "name": "chat-page-state",
        "description": "读取当前 chat 页 UI 状态快照"
      },
      {
        "name": "list-messages",
        "description": "列出当前会话的消息元数据（永不含正文）"
      },
      {
        "name": "get-message",
        "description": "读取单条消息（默认 redact=off）"
      },
      {
        "name": "get-session-tree",
        "description": "读取会话全分支树（含被埋藏的旧分支兄弟）"
      },
      {
        "name": "list-branch-points",
        "description": "仅列出会话中的分支点 + 每分支 children 摘要（轻量）"
      },
      {
        "name": "get-branch-path",
        "description": "从指定 leaf messageId 反推 root 的线性路径（默认 leaf=current）"
      },
      {
        "name": "streaming-status",
        "description": "一次性观察 assistant 是否在产出"
      },
      {
        "name": "chat-settings-view",
        "description": "只读拉 /api/v0/client/settings"
      },
      {
        "name": "navigate-home",
        "description": "导航到 / （INTERACTIVE）"
      },
      {
        "name": "navigate-session",
        "description": "导航到 /a/chat/s/<id> （INTERACTIVE）"
      },
      {
        "name": "navigate-new-chat",
        "description": "导航到 / 起新对话（INTERACTIVE）"
      },
      {
        "name": "create-session",
        "description": "[DESTRUCTIVE] 创建新会话，返回 sessionId"
      },
      {
        "name": "rename-session",
        "description": "[DESTRUCTIVE] 重命名会话标题"
      },
      {
        "name": "pin-session",
        "description": "[DESTRUCTIVE] 置顶会话"
      },
      {
        "name": "unpin-session",
        "description": "[DESTRUCTIVE] 取消置顶会话"
      },
      {
        "name": "feedback-message",
        "description": "[DESTRUCTIVE] 对单条消息发反馈（赞/踩/取消）"
      },
      {
        "name": "stop-stream",
        "description": "[DESTRUCTIVE] 停止当前流式生成"
      },
      {
        "name": "send-message",
        "description": "[DESTRUCTIVE,COST] 发消息触发流式生成（含 PoW）"
      },
      {
        "name": "edit-message",
        "description": "[DESTRUCTIVE,COST] 编辑用户消息并重生（含 PoW）"
      },
      {
        "name": "regenerate-message",
        "description": "[DESTRUCTIVE,COST] 基于 parent 重生 assistant 回复（含 PoW）"
      },
      {
        "name": "upload-file",
        "description": "[DESTRUCTIVE] 上传文件（base64 输入）"
      },
      {
        "name": "list-files",
        "description": "[READ] 列出当前账号上传的文件"
      },
      {
        "name": "share-session",
        "description": "[DESTRUCTIVE] 创建分享链接"
      },
      {
        "name": "unshare-session",
        "description": "[DESTRUCTIVE,IRREVERSIBLE] 删除分享链接"
      },
      {
        "name": "list-shares",
        "description": "[READ] 列出当前账号的分享链接"
      },
      {
        "name": "update-user-settings",
        "description": "[DESTRUCTIVE] 更新账号设置（白名单字段）"
      },
      {
        "name": "export-session-local",
        "description": "[本地] 把单个会话导出为本地 JSON / Markdown"
      }
    ]
  },
  "tools": [
    {
      "name": "deepseek_session_state",
      "title": "DeepSeek Ops: Session State",
      "description": "读取当前浏览器中 DeepSeek Chat 的登录态（/api/v0/users/current）",
      "risk": "read",
      "capabilities": [
        "browser.tabs.read",
        "browser.navigation",
        "browser.script.execute",
        "filesystem.skillData"
      ],
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "deepseek_list_sessions",
      "title": "DeepSeek Ops: List Sessions",
      "description": "列出历史会话（标题 / 时间 / 模型类型），不含消息正文",
      "risk": "read",
      "capabilities": [
        "browser.tabs.read",
        "browser.navigation",
        "browser.script.execute",
        "filesystem.skillData"
      ],
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "description": "默认 25，上限 100",
            "minimum": 0,
            "maximum": 100
          },
          "beforeSeqId": {
            "type": "string",
            "description": "分页游标",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "deepseek_get_session",
      "title": "DeepSeek Ops: Get Session",
      "description": "读取单个会话的消息历史。默认 redact=\"off\"：messages[].content 替换为 sha256+length",
      "risk": "read",
      "capabilities": [
        "browser.tabs.read",
        "browser.navigation",
        "browser.script.execute",
        "filesystem.skillData"
      ],
      "inputSchema": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "limit": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "redact": {
            "type": "string",
            "enum": [
              "off",
              "trunc",
              "full"
            ],
            "default": "off",
            "minLength": 1,
            "maxLength": 1000
          },
          "truncLen": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "contentMaxLen": {
            "type": "integer",
            "minimum": 0,
            "maximum": 200000
          }
        },
        "required": [
          "sessionId"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "deepseek_chat_page_state",
      "title": "DeepSeek Ops: Chat Page State",
      "description": "读取当前 chat 页 UI 状态快照（composer 草稿仅出 length+sha256）",
      "risk": "read",
      "capabilities": [
        "browser.tabs.read",
        "browser.navigation",
        "browser.script.execute",
        "filesystem.skillData"
      ],
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "deepseek_list_messages",
      "title": "DeepSeek Ops: List Messages",
      "description": "列出指定会话的消息元数据。永不返回 content / thinkingContent 正文",
      "risk": "read",
      "capabilities": [
        "browser.tabs.read",
        "browser.navigation",
        "browser.script.execute",
        "filesystem.skillData"
      ],
      "inputSchema": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "limit": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "contentMaxLen": {
            "type": "integer",
            "minimum": 0,
            "maximum": 200000
          }
        },
        "required": [
          "sessionId"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "deepseek_get_message",
      "title": "DeepSeek Ops: Get Message",
      "description": "读取单条消息详情。默认 redact=\"off\"",
      "risk": "read",
      "capabilities": [
        "browser.tabs.read",
        "browser.navigation",
        "browser.script.execute",
        "filesystem.skillData"
      ],
      "inputSchema": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "messageId": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "redact": {
            "type": "string",
            "enum": [
              "off",
              "trunc",
              "full"
            ],
            "default": "off",
            "minLength": 1,
            "maxLength": 1000
          },
          "truncLen": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "contentMaxLen": {
            "type": "integer",
            "minimum": 0,
            "maximum": 200000
          }
        },
        "required": [
          "sessionId",
          "messageId"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "deepseek_get_session_tree",
      "title": "DeepSeek Ops: Get Session Tree",
      "description": "读取会话全分支树（含被埋藏的旧分支兄弟）。返回 SessionTree（nodes map + activePathIds + branchPointIds + stats）。默认 redact=\"off\"。",
      "risk": "read",
      "capabilities": [
        "browser.tabs.read",
        "browser.navigation",
        "browser.script.execute",
        "filesystem.skillData"
      ],
      "inputSchema": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "redact": {
            "type": "string",
            "enum": [
              "off",
              "trunc",
              "full"
            ],
            "default": "off",
            "minLength": 1,
            "maxLength": 1000
          },
          "truncLen": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "contentMaxLen": {
            "type": "integer",
            "minimum": 0,
            "maximum": 200000
          },
          "limit": {
            "type": "integer",
            "description": "节点上限，0=不限；超限按 messageId 倒序保留最新",
            "minimum": 0,
            "maximum": 100
          }
        },
        "required": [
          "sessionId"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "deepseek_list_branch_points",
      "title": "DeepSeek Ops: List Branch Points",
      "description": "仅列出会话中的分支点（同 parent 下 children >= 2 的节点）+ 每分支的 children 元数据。轻量发现工具，永不返回正文。",
      "risk": "read",
      "capabilities": [
        "browser.tabs.read",
        "browser.navigation",
        "browser.script.execute",
        "filesystem.skillData"
      ],
      "inputSchema": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "required": [
          "sessionId"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "deepseek_get_branch_path",
      "title": "DeepSeek Ops: Get Branch Path",
      "description": "返回从 root 到指定 leaf messageId 的线性 messages[]，schema 与 deepseek_get_session 兼容。leaf 省略时等价于 active path（current_message_id）。",
      "risk": "read",
      "capabilities": [
        "browser.tabs.read",
        "browser.navigation",
        "browser.script.execute",
        "filesystem.skillData"
      ],
      "inputSchema": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "leafMessageId": {
            "type": "integer",
            "description": "目标分支末端 messageId；省略则用 session.current_message_id",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "redact": {
            "type": "string",
            "enum": [
              "off",
              "trunc",
              "full"
            ],
            "default": "off",
            "minLength": 1,
            "maxLength": 1000
          },
          "truncLen": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "contentMaxLen": {
            "type": "integer",
            "minimum": 0,
            "maximum": 200000
          },
          "limit": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        },
        "required": [
          "sessionId"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "deepseek_streaming_status",
      "title": "DeepSeek Ops: Streaming Status",
      "description": "一次性观察 chat 页 streaming 状态（不订阅 SSE）",
      "risk": "read",
      "capabilities": [
        "browser.tabs.read",
        "browser.navigation",
        "browser.script.execute",
        "filesystem.skillData"
      ],
      "inputSchema": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "deepseek_chat_settings_view",
      "title": "DeepSeek Ops: Chat Settings View",
      "description": "只读 /api/v0/client/settings（model 列表 / feature flags）",
      "risk": "read",
      "capabilities": [
        "browser.tabs.read",
        "browser.navigation",
        "browser.script.execute",
        "filesystem.skillData"
      ],
      "inputSchema": {
        "type": "object",
        "properties": {
          "scope": {
            "type": "string",
            "enum": [
              "main",
              "model"
            ],
            "default": "main",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "deepseek_list_files",
      "title": "DeepSeek Ops: List Files",
      "description": "列出当前账号上传的文件",
      "risk": "read",
      "capabilities": [
        "browser.tabs.read",
        "browser.navigation",
        "browser.script.execute",
        "filesystem.skillData"
      ],
      "inputSchema": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "deepseek_list_shares",
      "title": "DeepSeek Ops: List Shares",
      "description": "列出当前账号的分享链接",
      "risk": "read",
      "capabilities": [
        "browser.tabs.read",
        "browser.navigation",
