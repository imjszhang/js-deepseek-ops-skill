      }
    },
    {
      "name": "deepseek_rename_session",
      "title": "DeepSeek Ops: Rename Session",
      "description": "[DESTRUCTIVE,reversible] 重命名会话标题（最大 200 字）",
      "risk": "destructive",
      "capabilities": [
