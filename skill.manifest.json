    {
      "name": "deepseek_create_session",
      "title": "DeepSeek Ops: Create Session",
      "description": "[DESTRUCTIVE,reversible] 创建新会话；返回 sessionId 用于后续 send_message 等",
      "risk": "destructive",
      "capabilities": [
        "browser.tabs.read",
        "browser.navigation",
